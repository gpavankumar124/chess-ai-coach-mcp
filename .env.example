# Optional configuration for the Chess AI Coach MCP server.
# Copy to ".env" only if you need to override a default. Nothing here is required.

# Absolute path to a Stockfish executable.
# If unset, the server looks in ./engine/ first, then on your system PATH.
# STOCKFISH_PATH=C:\tools\stockfish\stockfish.exe

# Log verbosity: DEBUG, INFO, WARNING, ERROR. Default is INFO.
# Logs go to stderr and to data/chess_coach.log.
# CHESS_COACH_LOG_LEVEL=INFO
